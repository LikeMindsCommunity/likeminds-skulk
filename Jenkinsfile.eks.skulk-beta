pipeline {
    agent any
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
         }

         stage("Executing the Script Migration step for skulk-beta") {
            steps {
                script{
                    sh """ssh -tt -i "/var/lib/jenkins/.ssh/id_rsa" root@$migration_server_IP << EOF
                    cd /home/apps/skulk-beta/LikeMinds-Subscription && git checkout development && git pull
                    chmod +x /home/apps/skulk-beta/LikeMinds-Subscription/Migrationfile-skulk-beta.sh
                    . /home/apps/skulk-beta/LikeMinds-Subscription/Migrationfile-skulk-beta.sh
                    cd /home/apps/skulk-beta/LikeMinds-Subscription && git checkout /home/apps/skulk-beta/LikeMinds-Subscription/Migrationfile-skulk-beta.sh
                    exit
                    EOF"""
                }
            }
        }
        
        stage ('Build Image') {
            steps {
                sh "sudo docker build -f Dockerfile.skulk-beta -t 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-subscription-skulk-repo:skulk-V$BUILD_NUMBER ."
            }
        }
        
        stage ('Push Image') {
            steps {
                sh "aws ecr get-login-password --region ap-south-1 | sudo docker login --username AWS --password-stdin 081371230266.dkr.ecr.ap-south-1.amazonaws.com"
                sh "sudo docker push 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-subscription-skulk-repo:skulk-V$BUILD_NUMBER"
            }
        }
        
        stage ('Remove Image from jenkins') {
            steps {
                sh "sudo docker rmi 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-subscription-skulk-repo:skulk-V$BUILD_NUMBER"
            }
        }
        stage ("update tag and push helm charts") {
          steps {
             script{
                  git branch: 'LM-10466-aws-migration', url: 'git@github.com:LikeMindsCommunity/LikeMinds-Infra-Config.git'
                  sh "ls"
                  sh 'sed -i "s/tag: skulk-V[0-9]*/tag: skulk-V${BUILD_NUMBER}/g" ./stag/skulk-beta/values.yaml'
                  sh "git add ./stag/skulk-beta/values.yaml"
                  sh "git status"
                  sh 'git commit -m "CI/CD pipeline updated $IMAGE_TAG image to new image tag"'
                  sh 'git config --global credential.helper cache'
		  sh "git push origin LM-10466-aws-migration"
                }
            }
        }
    }
}
