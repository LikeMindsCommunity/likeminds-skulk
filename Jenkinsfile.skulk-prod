pipeline {
    agent any
    environment {
        PROJECT_ID = 'likeminds-prod-prj-5464'
        CLUSTER_NAME = 'likeminds-prod-autopilot-cluster'
        LOCATION = 'asia-south1'
        CREDENTIALS_ID = 'likeminds-prod-prj-5464'
    }
   
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
        }
      
        stage("Building Application Docker Image"){
          when { changeset "Dockerfile.skulk-prod"}
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker build -f Dockerfile.skulk-prod -t asia.gcr.io/likeminds-prod-prj-5464/likeminds-subscription/skulk:${BUILD_NUMBER} . '
                    }
                }
            }
         stage("Pushing Application Docker Image to Google Artifact Registry"){
           when { changeset "Dockerfile.skulk-prod"}
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker push asia.gcr.io/likeminds-prod-prj-5464/likeminds-subscription/skulk:${BUILD_NUMBER}'
                      }
                 }
            }
              
        stage('Deploy to GKE') {
          when { changeset "Dockerfile.skulk-prod"}
            steps{
                
                sh "sed 's/skulk:.*/skulk:${BUILD_NUMBER}/g' deployment-skulk-prod.yaml"
                sh "gcloud container clusters get-credentials ${env.CLUSTER_NAME} --region ${env.LOCATION} --project ${env.PROJECT_ID} --internal-ip"
                sh 'kubectl apply -f /var/lib/jenkins/workspace/likeminds-skulk-prod/deployment-skulk-prod.yaml'
                
            }
        }
    }  
        post { 
        always { 
            cleanWs()
        }
    }

}

