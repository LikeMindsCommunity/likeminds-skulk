pipeline {
    agent any
    // environment {
    //     PROJECT_ID = 'likeminds-prod-prj-5464'
    //     CLUSTER_NAME = 'likeminds-prod-autopilot-cluster'
    //     LOCATION = 'asia-south1'
    //     CREDENTIALS_ID = 'likeminds-prod-prj-5464'
    // }
   
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
        }

        stage("Executing the Script Migration step for skulk-prod") {
            steps {
                script{
                    sh '''
                       gcloud compute ssh likeminds-prod-migration-instance --zone=asia-south1-a --internal-ip --command="sudo chown -R jenkins  /home/apps/skulk-prod/"
                       gcloud compute ssh likeminds-prod-migration-instance --zone=asia-south1-a --internal-ip --command="chmod +x /home/apps/skulk-prod/LikeMinds-Subscription/Migrationfile-skulk-prod.sh"
                       gcloud compute ssh likeminds-prod-migration-instance --zone=asia-south1-a --internal-ip --command=". /home/apps/skulk-prod/LikeMinds-Subscription/Migrationfile-skulk-prod.sh"
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command="cd /home/apps/skulk-prod/LikeMinds-Subscription && git checkout ."
                      '''
                }
                
            }
        }
      
        stage("Building Application Docker Image"){
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker build -f Dockerfile.skulk-prod -t asia.gcr.io/likeminds-prod-prj-5464/likeminds-subscription/skulk:${BUILD_NUMBER} . '
                }
            }
        }

        stage("Pushing Application Docker Image to Google Artifact Registry"){
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker push asia.gcr.io/likeminds-prod-prj-5464/likeminds-subscription/skulk:${BUILD_NUMBER}'
                  }
             }
        }
              
        stage('Deploy to GKE') {
            steps{
                sh '''
                sed -i 's/skulk:.*/skulk:'${BUILD_NUMBER}'"/g' deployment-skulk-prod.yaml
                gcloud container clusters get-credentials ${CLUSTER_NAME} --region ${LOCATION} --project ${PROJECT_ID} --internal-ip
                kubectl apply -f /var/lib/jenkins/workspace/likeminds-skulk-prod/deployment-skulk-prod.yaml
                '''
            }
        }
    }  
    post {
        always { 
            cleanWs()
        }
    }
}
