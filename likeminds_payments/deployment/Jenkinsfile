sshID='subscription-beta'
pipeline{
    agent any

    stages{
        stage("beta-deployment"){
            when{
                branch 'test_deployment'
            }

            stages{
                stage("deployment-initial"){
                    steps{
                        sshagent([sshID]){
                            // To transfer the file FTP
                            sh 'ssh -o StrictHostKeyChecking=no -l root ec2-13-233-242-7.ap-south-1.compute.amazonaws.com whoami'
                        }
                    }
                }
                stage("deployment-celery"){
                    steps{
                        echo "Hello"
                    }
                }
            }
        }
    }
}
