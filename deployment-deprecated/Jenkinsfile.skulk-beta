// Deployment jenkins script file for GCP GKE skulk-beta deployment
// We have moved deployment to AWS jenkins deploying service on AWS EKS
// File is deprecated and moved to deployment-deprecated directory

pipeline {
    agent any
    // environment {
    //     PROJECT_ID = 'likeminds-nonprod-prj-24e1'
    //     CLUSTER_NAME = 'likeminds-nonprod-autopilot-cluster'
    //     LOCATION = 'asia-south1'
    //     CREDENTIALS_ID = 'likeminds-nonprod-prj-24e1'
    // }
   
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
        }

        stage("Executing the Script Migration step for skulk-beta") {
            steps {
                script{
                    sh '''
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command="sudo chown -R jenkins /home/apps/skulk-beta/"
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command="cd /home/apps/skulk-beta/LikeMinds-Subscription && git checkout development && git pull"
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command="chmod +x /home/apps/skulk-beta/LikeMinds-Subscription/Migrationfile-skulk-beta.sh"
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command=". /home/apps/skulk-beta/LikeMinds-Subscription/Migrationfile-skulk-beta.sh"
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command="cd /home/apps/skulk-beta/LikeMinds-Subscription && git checkout ."
                      '''
                }
            }
        }

        stage("Building Application Docker Image"){
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker build -f Dockerfile.skulk-beta -t asia.gcr.io/likeminds-nonprod-prj-24e1/github.com/nateshr/likeminds-subscription/skulk-beta:${BUILD_NUMBER} . '
                }
            }
        }

        stage("Pushing Application Docker Image to Google Artifact Registry"){
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker push asia.gcr.io/likeminds-nonprod-prj-24e1/github.com/nateshr/likeminds-subscription/skulk-beta:${BUILD_NUMBER}'
                  }
             }
        }
              
        stage('Deploy to GKE') {
            steps{
                sh '''
                sed -i 's/skulk-beta:.*/skulk-beta:'${BUILD_NUMBER}'"/g' deployment-skulk-beta.yaml
                gcloud container clusters get-credentials ${CLUSTER_NAME} --region ${LOCATION} --project ${PROJECT_ID} --internal-ip
                kubectl apply -f /var/lib/jenkins/workspace/likeminds-skulk-beta/deployment-skulk-beta.yaml
                '''
            }
        }
    }

    post {
        always { 
            cleanWs()
        }
    }
}
